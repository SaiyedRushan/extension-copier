{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Extension Copier",
  "version": "0.1.0",
  "identifier": "com.rushanshah.extensioncopier",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Extension Copier",
        "width": 720,
        "height": 640,
        "minWidth": 560,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "publisher": "Rushanshah Saiyed",
    "copyright": "Copyright (c) 2026 Rushanshah Saiyed. MIT license.",
    "shortDescription": "Copy Chrome extensions from one profile to another",
    "longDescription": "Lists the extensions in each Chrome profile, opens their Chrome Web Store pages in the profile you're copying to, keeps track of what's added, and can copy their saved settings too.",
    "homepage": "https://saiyedrushan.github.io/extension-copier/"
  }
}
